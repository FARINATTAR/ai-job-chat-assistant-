# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./applications.db

# LLM Providers (Gemini free tier recommended or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Job Data
JOBS_DATA_PATH=../data/jobs.json
SKILLS_TAXONOMY_PATH=../data/skills_taxonomy.json

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

